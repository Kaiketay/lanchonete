{
  "env": {
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["airbnb-base", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "import/extensions": "off",
    "no-use-before-define": "off"
  },
  "globals": {
    "cy": "readonly",
    "Cypress": "readonly",
    "self": "readonly"
  }
}
